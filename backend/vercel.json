{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nestjs",
  "installCommand": "npm install",
  "functions": {
    "src/main.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{node_modules/.prisma/**,node_modules/@prisma/client/**,prisma/**}"
    }
  }
}
