# PostgreSQL
POSTGRES_USER=dilyum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dilyum
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/Restaurant_DB?schema=public

# NestJS
PORT=3001
# Comma-separated allowed browser origins (CORS)
FRONTEND_ORIGIN=http://localhost:3000,https://restaurant-8815.vercel.app
# Public customer SPA base for QR target URLs (no trailing slash).
# Production MUST be the real Vercel frontend — never localhost on Vercel.
PUBLIC_WEB_URL=http://localhost:3000

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# Super Admin seed (local development only — never commit real secrets)
SUPER_ADMIN_EMAIL=vvinit594@gmail.com
SUPER_ADMIN_PASSWORD=Admin@123
SUPER_ADMIN_NAME=Platform Super Admin

# Supabase Storage (image uploads — service role is SERVER-ONLY, never put in frontend)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public bucket name used by the API: media
# Create as Public in Supabase Dashboard → Storage if auto-create is disabled
