generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  RESTAURANT_OWNER
  RESTAURANT_MANAGER
  RESTAURANT_STAFF
  SALES_PERSON
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipRole {
  RESTAURANT_OWNER
  RESTAURANT_MANAGER
  RESTAURANT_STAFF
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
}

enum QrCodeStatus {
  ACTIVE
  DISABLED
}

enum SalesPersonStatus {
  ACTIVE
  INACTIVE
}

enum SalesLeadStatus {
  NEW
  CONTACTED
  INTERESTED
  DEMO
  CONVERTED
  LOST
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum CommissionRuleType {
  FIXED
  PERCENT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships           RestaurantMembership[]
  restaurantsCreated    Restaurant[]           @relation("RestaurantCreatedBy")
  salesProfile          SalesPerson?

  @@map("users")
}

model SalesPerson {
  id        String            @id @default(cuid())
  userId    String            @unique
  salesCode String            @unique
  phone     String?
  status    SalesPersonStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurants  Restaurant[]
  leads        SalesLead[]
  commissions  Commission[]

  @@index([status])
  @@map("sales_persons")
}

model SalesLead {
  id                    String          @id @default(cuid())
  salesPersonId         String
  contactName           String
  restaurantName        String
  phone                 String?
  email                 String?
  status                SalesLeadStatus @default(NEW)
  notes                 String?
  convertedRestaurantId String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  salesPerson SalesPerson @relation(fields: [salesPersonId], references: [id], onDelete: Cascade)

  @@index([salesPersonId, status, createdAt])
  @@map("sales_leads")
}

model CommissionRule {
  id        String             @id @default(cuid())
  planCode  String             @unique
  type      CommissionRuleType @default(FIXED)
  /// FIXED: rupees amount. PERCENT: percent of monthly plan price.
  value     Decimal            @db.Decimal(10, 2)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("commission_rules")
}

model Commission {
  id             String           @id @default(cuid())
  salesPersonId  String
  restaurantId   String
  subscriptionId String           @unique
  planCode       String
  amount         Decimal          @db.Decimal(10, 2)
  status         CommissionStatus @default(PENDING)
  notes          String?
  paidAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  salesPerson SalesPerson @relation(fields: [salesPersonId], references: [id], onDelete: Cascade)
  restaurant  Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([salesPersonId, status, createdAt])
  @@index([restaurantId])
  @@map("commissions")
}

model Restaurant {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  logoUrl         String?
  coverImageUrl   String?
  phone           String
  email           String
  address         String
  city            String
  state           String?
  pincode         String?
  status          RestaurantStatus @default(ACTIVE)
  createdByUserId String?
  salesPersonId   String?
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  createdBy     User?                    @relation("RestaurantCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  salesPerson   SalesPerson?             @relation(fields: [salesPersonId], references: [id], onDelete: SetNull)
  memberships   RestaurantMembership[]
  subscriptions Subscription[]
  branches      Branch[]
  categories    Category[]
  dishes        Dish[]
  qrCodes       QrCode[]
  diningTables  DiningTable[]
  orders        Order[]
  commissions   Commission[]

  @@index([createdByUserId])
  @@index([salesPersonId])
  @@index([status, deletedAt])
  @@map("restaurants")
}

model RestaurantMembership {
  id           String         @id @default(cuid())
  userId       String
  restaurantId String
  role         MembershipRole
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId])
  @@index([userId, isActive])
  @@map("restaurant_memberships")
}

model SubscriptionPlan {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  priceLabel String
  features   Json
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id           String             @id @default(cuid())
  restaurantId String
  planId       String
  status       SubscriptionStatus @default(ACTIVE)
  startedAt    DateTime           @default(now())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([restaurantId])
  @@map("subscriptions")
}

model Branch {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("branches")
}

model Category {
  id           String    @id @default(cuid())
  restaurantId String
  name         String
  slug         String
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishes     Dish[]

  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@index([restaurantId, isActive, sortOrder])
  @@map("categories")
}

model Dish {
  id             String    @id @default(cuid())
  restaurantId   String
  categoryId     String
  name           String
  slug           String
  description    String?
  price          Decimal   @db.Decimal(10, 2)
  imageUrl       String?
  calories       Int?
  protein        Float?
  carbohydrates  Float?
  fat            Float?
  ingredients    String[]  @default([])
  allergens      String[]  @default([])
  isVeg          Boolean   @default(true)
  isVegan        Boolean   @default(false)
  isJain         Boolean   @default(false)
  isAvailable    Boolean   @default(true)
  isPublished    Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@index([categoryId])
  @@index([restaurantId, deletedAt, isPublished, isAvailable])
  @@map("dishes")
}

model QrCode {
  id           String      @id @default(cuid())
  restaurantId String
  token        String      @unique
  targetUrl    String
  status       QrCodeStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@map("qr_codes")
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

model DiningTable {
  id           String    @id @default(cuid())
  restaurantId String
  label        String
  code         String
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive, sortOrder])
  @@map("dining_tables")
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  kotNumber      String?     @unique
  restaurantId   String
  tableId        String
  tableLabel     String
  status         OrderStatus @default(NEW)
  subtotal       Decimal     @db.Decimal(10, 2)
  taxAmount      Decimal     @default(0) @db.Decimal(10, 2)
  discountAmount Decimal     @default(0) @db.Decimal(10, 2)
  serviceCharge  Decimal     @default(0) @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)
  notes          String?
  idempotencyKey String?
  placedAt       DateTime    @default(now())
  acceptedAt     DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      DiningTable  @relation(fields: [tableId], references: [id])
  items      OrderItem[]

  @@unique([restaurantId, idempotencyKey])
  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, createdAt])
  @@index([tableId])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  dishId            String?
  dishNameSnapshot  String
  unitPriceSnapshot Decimal  @db.Decimal(10, 2)
  quantity          Int
  itemTotal         Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish  Dish? @relation(fields: [dishId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([dishId])
  @@map("order_items")
}

