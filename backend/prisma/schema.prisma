generator client {
  provider      = "prisma-client-js"
  // native = local; rhel/debian openssl 3 = Vercel Node serverless images
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  RESTAURANT_OWNER
  RESTAURANT_MANAGER
  RESTAURANT_STAFF
  SALES_PERSON
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipRole {
  RESTAURANT_OWNER
  RESTAURANT_MANAGER
  RESTAURANT_STAFF
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  TRIAL
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum QrCodeStatus {
  ACTIVE
  DISABLED
}

enum SalesPersonStatus {
  ACTIVE
  INACTIVE
}

enum SalesLeadStatus {
  NEW
  CONTACTED
  INTERESTED
  DEMO
  CONVERTED
  LOST
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum CommissionRuleType {
  FIXED
  PERCENT
}

enum LoyaltyCustomerStatus {
  ACTIVE
  INACTIVE
}

enum LoyaltyOfferType {
  COUPON
  DISCOUNT
  SPECIAL_OFFER
  CUSTOM_MESSAGE
}

enum LoyaltyOfferStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum LoyaltyProgramType {
  POINTS
  STAMP_CARD
  MEMBERSHIP_TIERS
  BIRTHDAY_REWARD
  REFER_EARN
  CASHBACK
  EXCLUSIVE_OFFERS
  ORDER_STREAK
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships           RestaurantMembership[]
  restaurantsCreated    Restaurant[]           @relation("RestaurantCreatedBy")
  salesProfile          SalesPerson?
  loyaltyCustomers      LoyaltyCustomer[]      @relation("LoyaltyCustomerCreatedBy")
  loyaltyOffersSent     LoyaltyOfferMessage[]  @relation("LoyaltyOfferSentBy")
  couponsCreated        Coupon[]               @relation("CouponCreatedBy")
  pushCampaignsSent     PushCampaign[]         @relation("PushCampaignSentBy")

  @@map("users")
}

model SalesPerson {
  id        String            @id @default(cuid())
  userId    String            @unique
  salesCode String            @unique
  phone     String?
  /// Payout destination for a future settlement flow. Optional; not a secret token.
  upiId     String?
  status    SalesPersonStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurants  Restaurant[]
  leads        SalesLead[]
  commissions  Commission[]

  @@index([status])
  @@map("sales_persons")
}

model SalesLead {
  id                    String          @id @default(cuid())
  salesPersonId         String
  contactName           String
  restaurantName        String
  phone                 String?
  email                 String?
  status                SalesLeadStatus @default(NEW)
  notes                 String?
  convertedRestaurantId String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  salesPerson SalesPerson @relation(fields: [salesPersonId], references: [id], onDelete: Cascade)

  @@index([salesPersonId, status, createdAt])
  @@map("sales_leads")
}

model CommissionRule {
  id        String             @id @default(cuid())
  planCode  String             @unique
  type      CommissionRuleType @default(FIXED)
  /// FIXED: rupees amount. PERCENT: percent of monthly plan price.
  value     Decimal            @db.Decimal(10, 2)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("commission_rules")
}

model Commission {
  id             String           @id @default(cuid())
  salesPersonId  String
  restaurantId   String
  subscriptionId String           @unique
  planCode       String
  amount         Decimal          @db.Decimal(10, 2)
  status         CommissionStatus @default(PENDING)
  notes          String?
  paidAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  salesPerson SalesPerson @relation(fields: [salesPersonId], references: [id], onDelete: Cascade)
  restaurant  Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([salesPersonId, status, createdAt])
  @@index([restaurantId])
  @@map("commissions")
}

model Restaurant {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  logoUrl         String?
  coverImageUrl   String?
  phone           String
  email           String
  address         String
  city            String
  state           String?
  pincode         String?
  status          RestaurantStatus @default(ACTIVE)
  createdByUserId String?
  salesPersonId   String?
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  createdBy     User?                    @relation("RestaurantCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  salesPerson   SalesPerson?             @relation(fields: [salesPersonId], references: [id], onDelete: SetNull)
  memberships   RestaurantMembership[]
  subscriptions Subscription[]
  branches      Branch[]
  categories    Category[]
  dishes        Dish[]
  qrCodes       QrCode[]
  diningTables  DiningTable[]
  orders        Order[]
  commissions   Commission[]
  payments      Payment[]
  loyaltyCustomers LoyaltyCustomer[]
  loyaltyOffers    LoyaltyOfferMessage[]
  loyaltyPrograms  RestaurantLoyaltyProgram[]
  restaurantCustomers RestaurantCustomer[]
  coupons             Coupon[]
  customerNotifications CustomerNotification[]
  pushCampaigns         PushCampaign[]

  @@index([createdByUserId])
  @@index([salesPersonId])
  @@index([status, deletedAt])
  @@map("restaurants")
}

model RestaurantMembership {
  id           String         @id @default(cuid())
  userId       String
  restaurantId String
  role         MembershipRole
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId])
  @@index([userId, isActive])
  @@map("restaurant_memberships")
}

model SubscriptionPlan {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  priceLabel          String
  /// Trusted rupee amount (backend source of truth).
  priceAmount         Decimal  @default(0) @db.Decimal(10, 2)
  billingMonths       Int      @default(1)
  /// When > 0, subscription end is startedAt + billingDays (e.g. free trial).
  billingDays         Int      @default(0)
  branchLimit         Int      @default(5)
  badge               String?
  description         String?
  specialNotice       String?
  isNewRestaurantOnly Boolean  @default(false)
  /// FREE_TRIAL | PAID
  planType            String   @default("PAID")
  paymentRequired     Boolean  @default(true)
  features            Json
  sortOrder           Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                     String             @id @default(cuid())
  restaurantId           String
  planId                 String
  status                 SubscriptionStatus @default(PENDING)
  startedAt              DateTime           @default(now())
  endsAt                 DateTime?
  /// Razorpay / billing fields (never store card/UPI secrets)
  razorpayCustomerId     String?
  razorpaySubscriptionId String?            @unique
  razorpayPlanId         String?
  razorpayPaymentId      String?
  razorpayTokenId        String?
  paymentStatus          PaymentStatus      @default(PENDING)
  paymentFailedAt        DateTime?
  gracePeriodStartedAt   DateTime?
  gracePeriodEndsAt      DateTime?
  lastPaymentAt          DateTime?
  nextPaymentAt          DateTime?
  currency               String             @default("INR")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan @relation(fields: [planId], references: [id])
  payments   Payment[]

  @@index([restaurantId])
  @@index([status, gracePeriodEndsAt])
  @@index([razorpayCustomerId])
  @@map("subscriptions")
}

model Payment {
  id                     String        @id @default(cuid())
  restaurantId           String
  subscriptionId         String?
  razorpayPaymentId      String?       @unique
  razorpaySubscriptionId String?
  razorpayOrderId        String?
  planCode               String
  amount                 Decimal       @db.Decimal(10, 2)
  currency               String        @default("INR")
  status                 PaymentStatus @default(PENDING)
  method                 String?
  failureReason          String?
  paidAt                 DateTime?
  rawPayload             Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([subscriptionId])
  @@map("payments")
}

model RazorpayWebhookEvent {
  id          String   @id @default(cuid())
  /// Razorpay event id — unique for idempotency
  eventId     String   @unique
  eventType   String
  payload     Json
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([eventType, processedAt])
  @@map("razorpay_webhook_events")
}

model LoyaltyCustomer {
  id                String                @id @default(cuid())
  restaurantId      String
  name              String
  phone             String
  whatsappPhone     String
  email             String?
  notes             String?
  marketingConsent  Boolean               @default(false)
  status            LoyaltyCustomerStatus @default(ACTIVE)
  totalOffersSent   Int                   @default(0)
  lastOfferSentAt   DateTime?
  createdByUserId   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  restaurant  Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdBy   User?                 @relation("LoyaltyCustomerCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  offers      LoyaltyOfferMessage[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, lastOfferSentAt])
  @@map("loyalty_customers")
}

model LoyaltyOfferMessage {
  id                String             @id @default(cuid())
  restaurantId      String
  customerId        String
  offerType         LoyaltyOfferType
  title             String?
  message           String
  couponCode        String?
  discountPercent   Decimal?           @db.Decimal(5, 2)
  minimumOrderValue Decimal?           @db.Decimal(10, 2)
  expiresAt         DateTime?
  providerMessageId String?
  status            LoyaltyOfferStatus @default(PENDING)
  sentByUserId      String?
  sentAt            DateTime?
  providerPayload   Json?
  failureReason     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   LoyaltyCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sentBy     User?           @relation("LoyaltyOfferSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, customerId, createdAt])
  @@index([restaurantId, status, createdAt])
  @@index([customerId, createdAt])
  @@map("loyalty_offer_messages")
}

model RestaurantLoyaltyProgram {
  id          String             @id @default(cuid())
  restaurantId String
  programType LoyaltyProgramType
  enabled     Boolean            @default(false)
  configuration Json
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, programType])
  @@index([restaurantId, enabled])
  @@map("restaurant_loyalty_programs")
}

model Branch {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("branches")
}

model Category {
  id           String    @id @default(cuid())
  restaurantId String
  name         String
  slug         String
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishes     Dish[]

  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@index([restaurantId, isActive, sortOrder])
  @@map("categories")
}

model Dish {
  id             String    @id @default(cuid())
  restaurantId   String
  categoryId     String
  name           String
  slug           String
  description    String?
  price          Decimal   @db.Decimal(10, 2)
  imageUrl       String?
  calories       Int?
  protein        Float?
  carbohydrates  Float?
  fat            Float?
  ingredients    String[]  @default([])
  allergens      String[]  @default([])
  isVeg          Boolean   @default(true)
  isVegan        Boolean   @default(false)
  isJain         Boolean   @default(false)
  isAvailable    Boolean   @default(true)
  isPublished    Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@index([categoryId])
  /// Public menu: restaurantId + published/available flags, ordered by name.
  @@index([restaurantId, deletedAt, isPublished, isAvailable, name])
  @@map("dishes")
}

model QrCode {
  id           String      @id @default(cuid())
  restaurantId String
  token        String      @unique
  targetUrl    String
  status       QrCodeStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@map("qr_codes")
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

enum CustomerCouponStatus {
  AVAILABLE
  USED
  EXPIRED
}

enum CustomerNotificationType {
  ORDER_STATUS
  OFFER
  COUPON
  LOYALTY
  PROMO
}

enum PushCampaignTargeting {
  ALL_ELIGIBLE
  PREVIOUSLY_ORDERED
  INDIVIDUAL
}

enum PushCampaignStatus {
  PENDING
  SENT
  PARTIAL
  FAILED
}

model DiningTable {
  id           String    @id @default(cuid())
  restaurantId String
  label        String
  code         String
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive, sortOrder])
  @@map("dining_tables")
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  kotNumber      String?     @unique
  restaurantId   String
  tableId        String
  tableLabel     String
  status         OrderStatus @default(NEW)
  subtotal       Decimal     @db.Decimal(10, 2)
  taxAmount      Decimal     @default(0) @db.Decimal(10, 2)
  discountAmount Decimal     @default(0) @db.Decimal(10, 2)
  serviceCharge  Decimal     @default(0) @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)
  notes          String?
  idempotencyKey String?
  customerId     String?
  customerDeviceId String?
  couponId       String?
  placedAt       DateTime    @default(now())
  acceptedAt     DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table          DiningTable     @relation(fields: [tableId], references: [id])
  items          OrderItem[]
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerDevice CustomerDevice? @relation(fields: [customerDeviceId], references: [id], onDelete: SetNull)
  coupon         Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  notifications  CustomerNotification[]

  @@unique([restaurantId, idempotencyKey])
  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, createdAt])
  @@index([tableId])
  @@index([customerId, createdAt])
  @@index([customerId, status, createdAt])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  dishId            String?
  dishNameSnapshot  String
  unitPriceSnapshot Decimal  @db.Decimal(10, 2)
  quantity          Int
  itemTotal         Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish  Dish? @relation(fields: [dishId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([dishId])
  @@map("order_items")
}

/// Anonymous diner identity. One customer may have many devices.
model Customer {
  id          String   @id @default(cuid())
  displayName String?
  phone       String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices       CustomerDevice[]
  orders        Order[]
  restaurants   RestaurantCustomer[]
  coupons       CustomerCoupon[]
  notifications CustomerNotification[]

  @@index([createdAt])
  @@map("customers")
}

model CustomerDevice {
  id         String   @id @default(cuid())
  customerId String
  publicId   String   @unique
  secretHash String
  userAgent  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer          Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders            Order[]
  pushSubscriptions CustomerPushSubscription[]

  @@index([customerId])
  @@index([lastSeenAt])
  @@map("customer_devices")
}

model CustomerPushSubscription {
  id        String   @id @default(cuid())
  deviceId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  device CustomerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("customer_push_subscriptions")
}

model RestaurantCustomer {
  id            String   @id @default(cuid())
  restaurantId  String
  customerId    String
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  lastOrderedAt DateTime?
  orderCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, customerId])
  @@index([restaurantId, lastOrderedAt])
  @@index([restaurantId, lastSeenAt])
  @@index([customerId])
  @@map("restaurant_customers")
}

model Coupon {
  id                String             @id @default(cuid())
  restaurantId      String
  title             String
  description       String?
  discountType      CouponDiscountType
  discountValue     Decimal            @db.Decimal(10, 2)
  code              String
  minimumOrderValue Decimal?           @db.Decimal(10, 2)
  maximumDiscount   Decimal?           @db.Decimal(10, 2)
  startsAt          DateTime           @default(now())
  expiresAt         DateTime?
  usageLimit        Int?
  usedCount         Int                @default(0)
  isActive          Boolean            @default(true)
  createdByUserId   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdBy  User?            @relation("CouponCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  grants     CustomerCoupon[]
  orders     Order[]
  notifications CustomerNotification[]
  campaigns     PushCampaign[]

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive, expiresAt])
  @@index([restaurantId, createdAt])
  @@map("coupons")
}

model CustomerCoupon {
  id         String               @id @default(cuid())
  couponId   String
  customerId String
  status     CustomerCouponStatus @default(AVAILABLE)
  usedAt     DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([couponId, customerId])
  @@index([customerId, status, createdAt])
  @@index([couponId, status])
  @@map("customer_coupons")
}

model CustomerNotification {
  id             String                   @id @default(cuid())
  customerId     String
  restaurantId   String?
  type           CustomerNotificationType
  title          String
  message        String
  orderId        String?
  couponId       String?
  campaignId     String?
  readAt         DateTime?
  createdAt      DateTime                 @default(now())

  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant Restaurant?  @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  order      Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  coupon     Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  campaign   PushCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([customerId, readAt, createdAt])
  @@index([customerId, createdAt])
  @@index([restaurantId, createdAt])
  @@map("customer_notifications")
}

model PushCampaign {
  id             String                 @id @default(cuid())
  restaurantId   String
  title          String
  message        String
  targeting      PushCampaignTargeting
  couponId       String?
  recipientCount Int                    @default(0)
  deliveredCount Int                    @default(0)
  failedCount    Int                    @default(0)
  status         PushCampaignStatus     @default(PENDING)
  sentByUserId   String?
  sentAt         DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  restaurant    Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  coupon        Coupon?                @relation(fields: [couponId], references: [id], onDelete: SetNull)
  sentBy        User?                  @relation("PushCampaignSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)
  notifications CustomerNotification[]

  @@index([restaurantId, createdAt])
  @@index([restaurantId, status, createdAt])
  @@map("push_campaigns")
}

